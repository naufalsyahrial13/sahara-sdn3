---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---
<Layout title="Beranda - SAHARA SDN 3 Tirtomoyo">
  <Navbar current="beranda" />

  <header class="relative max-w-5xl mx-auto px-4 pt-10 pb-6 text-center overflow-hidden">
    <span class="float-badge hidden sm:flex absolute -top-1 left-8 text-3xl" style="animation-delay:0s">🎨</span>
    <span class="float-badge hidden sm:flex absolute top-10 right-6 text-3xl" style="animation-delay:0.9s">📖</span>
    <span class="float-badge hidden sm:flex absolute bottom-0 left-20 text-2xl" style="animation-delay:1.6s">🔬</span>
    <span class="float-badge hidden sm:flex absolute bottom-4 right-20 text-2xl" style="animation-delay:2.3s">🎬</span>

    <h1 class="fade-in-up relative text-3xl md:text-4xl font-extrabold text-ink">Museum Digital SAHARA</h1>
    <p class="fade-in-up relative mt-2 text-ink-soft" style="animation-delay:0.1s">Setiap Hari Berkarya, Setiap Karya Menginspirasi</p>
    <p id="stat-badge" class="fade-in-up relative inline-block mt-4 bg-white border-2 border-line rounded-full px-4 py-1.5 text-xs font-bold text-ink-soft" style="animation-delay:0.2s"></p>
  </header>

  <div class="max-w-5xl mx-auto px-4 mb-6 flex gap-3">
    <div class="relative flex-1">
      <button id="cat-trigger" type="button" class="w-full flex items-center justify-between gap-2 bg-white border-2 border-line rounded-xl px-4 py-2.5 text-sm font-bold text-ink">
        <span class="flex items-center gap-1.5 truncate">🎨 <span id="cat-label">Semua Kategori</span></span>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div id="cat-panel" class="hidden absolute z-20 mt-2 w-full bg-white border-2 border-line rounded-2xl p-3 shadow-xl flex flex-wrap gap-2">
        <button data-cat="Semua" class="filter-btn bg-ink text-white active">Semua</button>
        <button data-cat="Gambar" class="filter-btn bg-gambar-50 text-gambar-600">Gambar</button>
        <button data-cat="Cerita" class="filter-btn bg-cerita-50 text-cerita-600">Cerita</button>
        <button data-cat="Puisi" class="filter-btn bg-puisi-50 text-puisi-600">Puisi</button>
        <button data-cat="Eksperimen" class="filter-btn bg-eksperimen-50 text-eksperimen-600">Eksperimen</button>
        <button data-cat="Video" class="filter-btn bg-video-50 text-video-600">Video</button>
        <button data-cat="Infografis" class="filter-btn bg-infografis-50 text-infografis-600">Infografis</button>
      </div>
    </div>

    <div class="relative flex-1">
      <button id="kelas-trigger" type="button" class="w-full flex items-center justify-between gap-2 bg-white border-2 border-line rounded-xl px-4 py-2.5 text-sm font-bold text-ink">
        <span class="flex items-center gap-1.5 truncate">🎓 <span id="kelas-label">Semua Kelas</span></span>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div id="kelas-panel" class="hidden absolute z-20 mt-2 w-full bg-white border-2 border-line rounded-2xl p-3 shadow-xl flex flex-wrap gap-2">
        <button data-kelas="Semua" class="kelas-btn active">Semua Kelas</button>
        <button data-kelas="1" class="kelas-btn">Kelas 1</button>
        <button data-kelas="2" class="kelas-btn">Kelas 2</button>
        <button data-kelas="3" class="kelas-btn">Kelas 3</button>
        <button data-kelas="4" class="kelas-btn">Kelas 4</button>
        <button data-kelas="5" class="kelas-btn">Kelas 5</button>
        <button data-kelas="6" class="kelas-btn">Kelas 6</button>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 mb-6">
    <div class="relative">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-ink-faint pointer-events-none"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input id="search-input" type="text" placeholder="Cari nama siswa atau judul karya..." class="w-full bg-white border-2 border-line rounded-xl pl-10 pr-4 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:border-brand-500 outline-none" />
    </div>
  </div>

  <main class="max-w-5xl mx-auto px-4 pb-16">
    <div id="loading" class="grid grid-cols-2 md:grid-cols-3 gap-4">
      {Array.from({ length: 6 }).map(() => (
        <div class="rounded-2xl overflow-hidden bg-surface border-2 border-line">
          <div class="skeleton h-36 w-full"></div>
          <div class="p-2.5 space-y-2">
            <div class="skeleton h-3 w-3/4 rounded-full"></div>
            <div class="skeleton h-2.5 w-1/2 rounded-full"></div>
          </div>
        </div>
      ))}
    </div>
    <div id="empty" class="hidden text-center text-ink-faint py-16">
      <p class="text-4xl mb-2">🖼️</p>
      <p class="font-bold text-ink">Belum ada karya di kategori ini.</p>
      <p class="text-sm mt-1">Coba pilih kategori atau kelas lain ya.</p>
    </div>
    <div id="gallery-grid" class="grid grid-cols-2 md:grid-cols-3 gap-4"></div>
  </main>

  <div id="modal" class="hidden fixed inset-0 bg-ink/60 backdrop-blur-sm z-50 items-center justify-center p-4">
    <div id="modal-box" class="modal-box bg-surface rounded-2xl max-w-lg w-full overflow-hidden relative shadow-2xl">
      <button id="modal-close" class="absolute top-2 right-2 bg-white/90 hover:bg-white hover:scale-110 rounded-full w-8 h-8 font-bold z-10 transition">✕</button>
      <div id="modal-media"></div>
      <div class="p-4 max-h-[60vh] overflow-y-auto">
        <h3 id="modal-title" class="font-bold text-lg text-ink"></h3>
        <p id="modal-meta" class="text-sm text-ink-faint mt-1"></p>

        <div class="mt-4 pt-4 border-t-2 border-line">
          <p class="text-xs font-bold text-ink-soft mb-2">Komentar &amp; Feedback</p>
          <div id="comment-list" class="space-y-2 mb-3"></div>
          <div class="space-y-2">
            <input id="comment-nama" type="text" placeholder="Nama kamu" class="w-full border-2 border-line rounded-lg px-3 py-2 text-sm focus:border-brand-500 outline-none" />
            <textarea id="comment-teks" rows="2" placeholder="Tulis apresiasi atau masukan..." class="w-full border-2 border-line rounded-lg px-3 py-2 text-sm focus:border-brand-500 outline-none resize-none"></textarea>
            <button id="comment-submit" class="w-full bg-brand-500 hover:bg-brand-600 text-white rounded-lg py-2 text-sm font-bold transition">Kirim Komentar</button>
            <p id="comment-error" class="text-red-500 text-xs font-bold hidden"></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
	// @ts-nocheck
    import { db } from '../lib/firebase.js';
    import { collection, query, where, orderBy, getDocs, doc, updateDoc, addDoc, increment, serverTimestamp } from 'firebase/firestore';

    let allKarya = [];
    let activeCat = 'Semua';
    let activeKelas = 'Semua';
    let searchQuery = '';

    function getLikedIds() {
      try { return JSON.parse(localStorage.getItem('sahara-liked') || '[]'); } catch { return []; }
    }
    function saveLikedIds(ids) {
      localStorage.setItem('sahara-liked', JSON.stringify(ids));
    }

    const grid = document.getElementById('gallery-grid');
    const loading = document.getElementById('loading');
    const empty = document.getElementById('empty');
    const statBadge = document.getElementById('stat-badge');

    const AVATAR_COLORS = ['#FF6B85', '#4FA8F0', '#A672E8', '#4CC985', '#FFA83D', '#37C2AC'];
    const CATEGORY_TEXT = {
      Gambar: 'text-gambar-600', Cerita: 'text-cerita-600', Puisi: 'text-puisi-600',
      Eksperimen: 'text-eksperimen-600', Video: 'text-video-600', Infografis: 'text-infografis-600',
    };
    const CATEGORY_HEX = {
      Gambar: '#FF6B85', Cerita: '#4FA8F0', Puisi: '#A672E8',
      Eksperimen: '#4CC985', Video: '#FFA83D', Infografis: '#37C2AC',
    };
    const CATEGORY_ICON = {
      Gambar: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>',
      Cerita: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>',
      Puisi: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/><line x1="16" y1="8" x2="2" y2="22"/><line x1="17.5" y1="15" x2="9" y2="15"/></svg>',
      Eksperimen: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><path d="M9 2v6L4.5 17a2 2 0 0 0 1.8 3h11.4a2 2 0 0 0 1.8-3L15 8V2"/><line x1="8" y1="2" x2="16" y2="2"/><line x1="8.5" y1="13" x2="15.5" y2="13"/></svg>',
      Video: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M10 9l5 3-5 3z" fill="currentColor" stroke="none"/></svg>',
      Infografis: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><line x1="4" y1="20" x2="4" y2="10"/><line x1="10" y1="20" x2="10" y2="4"/><line x1="16" y1="20" x2="16" y2="14"/><line x1="21" y1="20" x2="3" y2="20"/></svg>',
    };

    function initials(name) { return (name || '?').trim().charAt(0).toUpperCase(); }
    function avatarColor(name) {
      const sum = (name || '').split('').reduce((a, c) => a + c.charCodeAt(0), 0);
      return AVATAR_COLORS[sum % AVATAR_COLORS.length];
    }
    function optimizedUrl(url, width) {
      if (!url || !url.includes('/upload/')) return url;
      return url.replace('/upload/', `/upload/f_auto,q_auto,w_${width},c_limit/`);
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('shown');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    async function loadKarya() {
      try {
        const q = query(collection(db, 'karya'), orderBy('createdAt', 'desc'));
        const snap = await getDocs(q);
        allKarya = snap.docs.map((d) => ({ id: d.id, ...d.data() }));
      } catch (err) {
        console.error(err);
      }
      loading.classList.add('hidden');
      statBadge.textContent = `🏆 ${allKarya.length} Karya Terkumpul`;
      render();
    }

    function render() {
      const q = searchQuery.trim().toLowerCase();
      const filtered = allKarya.filter((k) => {
        const matchCat = activeCat === 'Semua' || k.kategori === activeCat;
        const matchKelas = activeKelas === 'Semua' || String(k.kelas) === activeKelas;
        const matchSearch = !q || (k.nama || '').toLowerCase().includes(q) || (k.judul || '').toLowerCase().includes(q);
        return matchCat && matchKelas && matchSearch;
      });
      grid.innerHTML = '';
      empty.classList.toggle('hidden', filtered.length > 0);
      const likedIds = getLikedIds();
      filtered.forEach((k, idx) => {
        const thumbUrl = optimizedUrl(k.mediaUrl, 400);
        const card = document.createElement('div');
        card.className = 'karya-card reveal rounded-2xl overflow-hidden bg-surface border-2 border-line cursor-pointer';
        card.style.transitionDelay = `${Math.min(idx, 8) * 40}ms`;
        card.innerHTML = `
          <div class="h-1.5" style="background:${CATEGORY_HEX[k.kategori] || '#B8AA92'}"></div>
          <div class="relative overflow-hidden">
            ${
              k.mediaType === 'video'
                ? `<video src="${thumbUrl}" class="w-full h-36 object-cover" muted></video>
                   <span class="absolute inset-0 flex items-center justify-center pointer-events-none">
                     <span class="w-9 h-9 rounded-full bg-white/85 flex items-center justify-center">
                       <svg viewBox="0 0 24 24" width="14" height="14"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
                     </span>
                   </span>`
                : `<img src="${thumbUrl}" class="w-full h-36 object-cover" loading="lazy" />`
            }
            <span class="absolute top-2 left-2 flex items-center gap-1 bg-white/90 backdrop-blur px-2 py-1 rounded-full text-[10px] font-bold ${CATEGORY_TEXT[k.kategori] || 'text-ink-soft'}">
              ${CATEGORY_ICON[k.kategori] || ''} ${k.kategori ?? ''}
            </span>
          </div>
          <div class="p-2.5 flex items-center gap-2">
            <span class="w-7 h-7 rounded-full flex items-center justify-center text-white font-bold text-[11px] shrink-0" style="background:${avatarColor(k.nama)}">${initials(k.nama)}</span>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-bold text-ink truncate">${k.judul ?? ''}</p>
              <p class="text-[11px] text-ink-faint truncate">${k.nama ?? ''} &middot; Kelas ${k.kelas ?? ''}</p>
            </div>
            <button class="like-btn shrink-0 flex items-center gap-1 text-xs font-bold px-2 py-1 rounded-full transition ${likedIds.includes(k.id) ? 'text-white bg-brand-500' : 'text-ink-soft bg-canvas hover:bg-brand-50'}" data-id="${k.id}">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="${likedIds.includes(k.id) ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
              <span class="like-count">${k.likes || 0}</span>
            </button>
          </div>
        `;
        card.addEventListener('click', () => openModal(k));
        const likeBtn = card.querySelector('.like-btn');
        likeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleLike(k, likeBtn);
        });
        grid.appendChild(card);
        observer.observe(card);
      });
    }

    async function toggleLike(k, btn) {
      const likedIds = getLikedIds();
      const already = likedIds.includes(k.id);
      const countEl = btn.querySelector('.like-count');
      const delta = already ? -1 : 1;
      k.likes = Math.max(0, (k.likes || 0) + delta);
      countEl.textContent = k.likes;
      btn.classList.toggle('bg-brand-500', !already);
      btn.classList.toggle('text-white', !already);
      btn.classList.toggle('text-ink-soft', already);
      btn.classList.toggle('bg-canvas', already);
      btn.querySelector('svg').setAttribute('fill', already ? 'none' : 'currentColor');
      const newLiked = already ? likedIds.filter((id) => id !== k.id) : [...likedIds, k.id];
      saveLikedIds(newLiked);
      try {
        await updateDoc(doc(db, 'karya', k.id), { likes: increment(delta) });
      } catch (err) {
        console.error('Gagal update like', err);
      }
    }

    let currentKarya = null;

    function timeAgo(ts) {
      if (!ts?.toDate) return '';
      const diff = (Date.now() - ts.toDate().getTime()) / 1000;
      if (diff < 60) return 'baru saja';
      if (diff < 3600) return `${Math.floor(diff / 60)} menit lalu`;
      if (diff < 86400) return `${Math.floor(diff / 3600)} jam lalu`;
      return `${Math.floor(diff / 86400)} hari lalu`;
    }

    async function loadComments(karyaId) {
      const listEl = document.getElementById('comment-list');
      listEl.innerHTML = '<p class="text-xs text-ink-faint">Memuat komentar...</p>';
      try {
        const q = query(collection(db, 'komentar'), where('karyaId', '==', karyaId), orderBy('createdAt', 'desc'));
        const snap = await getDocs(q);
        if (snap.empty) {
          listEl.innerHTML = '<p class="text-xs text-ink-faint">Belum ada komentar. Jadi yang pertama!</p>';
          return;
        }
        listEl.innerHTML = '';
        snap.forEach((d) => {
          const c = d.data();
          const row = document.createElement('div');
          row.className = 'bg-canvas rounded-xl p-2.5';
          row.innerHTML = `
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full flex items-center justify-center text-white font-bold text-[10px] shrink-0" style="background:${avatarColor(c.nama)}">${initials(c.nama)}</span>
              <p class="text-xs font-bold text-ink">${c.nama ?? 'Anonim'}</p>
              <p class="text-[10px] text-ink-faint ml-auto">${timeAgo(c.createdAt)}</p>
            </div>
            <p class="text-sm text-ink-soft mt-1.5 ml-8">${c.teks ?? ''}</p>
          `;
          listEl.appendChild(row);
        });
      } catch (err) {
        console.error(err);
        listEl.innerHTML = '<p class="text-xs text-red-500">Gagal memuat komentar.</p>';
      }
    }

    document.getElementById('comment-submit')?.addEventListener('click', async () => {
      const nama = document.getElementById('comment-nama').value.trim();
      const teks = document.getElementById('comment-teks').value.trim();
      const errorEl = document.getElementById('comment-error');
      errorEl.classList.add('hidden');
      if (!nama || !teks) {
        errorEl.textContent = 'Isi nama dan komentarnya dulu ya.';
        errorEl.classList.remove('hidden');
        return;
      }
      if (!currentKarya) return;
      const btn = document.getElementById('comment-submit');
      btn.disabled = true;
      btn.textContent = 'Mengirim...';
      try {
        await addDoc(collection(db, 'komentar'), {
          karyaId: currentKarya.id,
          karyaJudul: currentKarya.judul ?? '',
          nama, teks,
          createdAt: serverTimestamp(),
        });
        document.getElementById('comment-teks').value = '';
        loadComments(currentKarya.id);
      } catch (err) {
        errorEl.textContent = 'Gagal mengirim: ' + err.message;
        errorEl.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Kirim Komentar';
      }
    });

    function openModal(k) {
      currentKarya = k;
      const modal = document.getElementById('modal');
      const box = document.getElementById('modal-box');
      const mediaUrl = optimizedUrl(k.mediaUrl, 800);
      document.getElementById('modal-title').textContent = k.judul ?? '';
      document.getElementById('modal-meta').textContent = `${k.nama ?? ''} · Kelas ${k.kelas ?? ''} · ${k.kategori ?? ''}`;
      document.getElementById('modal-media').innerHTML =
        k.mediaType === 'video'
          ? `<video src="${mediaUrl}" controls class="w-full max-h-96"></video>`
          : `<img src="${mediaUrl}" class="w-full max-h-96 object-contain" />`;
      document.getElementById('comment-nama').value = '';
      document.getElementById('comment-teks').value = '';
      document.getElementById('comment-error').classList.add('hidden');
      loadComments(k.id);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      requestAnimationFrame(() => box.classList.add('shown'));
    }

    function closeModal() {
      currentKarya = null;
      const modal = document.getElementById('modal');
      const box = document.getElementById('modal-box');
      const media = document.getElementById('modal-media');
      const video = media.querySelector('video');
      if (video) video.pause();
      box.classList.remove('shown');
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        media.innerHTML = '';
      }, 200);
    }

    document.getElementById('modal-close')?.addEventListener('click', closeModal);
    document.getElementById('modal')?.addEventListener('click', (e) => {
      if (e.target.id === 'modal') closeModal();
    });

    document.querySelectorAll('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeCat = btn.dataset.cat;
        render();
      });
    });

    document.querySelectorAll('.kelas-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.kelas-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeKelas = btn.dataset.kelas;
        render();
      });
    });

    loadKarya();

    let searchDebounce;
    document.getElementById('search-input')?.addEventListener('input', (e) => {
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(() => {
        searchQuery = e.target.value;
        render();
      }, 200);
    });
  </script>

  <script>
    const catTrigger = document.getElementById('cat-trigger');
    const catPanel = document.getElementById('cat-panel');
    const catLabel = document.getElementById('cat-label');
    const kelasTrigger = document.getElementById('kelas-trigger');
    const kelasPanel = document.getElementById('kelas-panel');
    const kelasLabel = document.getElementById('kelas-label');

    function closePanels() {
      catPanel?.classList.add('hidden');
      kelasPanel?.classList.add('hidden');
    }

    catTrigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const willOpen = catPanel.classList.contains('hidden');
      closePanels();
      if (willOpen) catPanel.classList.remove('hidden');
    });
    kelasTrigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const willOpen = kelasPanel.classList.contains('hidden');
      closePanels();
      if (willOpen) kelasPanel.classList.remove('hidden');
    });
    catPanel?.addEventListener('click', (e) => e.stopPropagation());
    kelasPanel?.addEventListener('click', (e) => e.stopPropagation());
    document.addEventListener('click', closePanels);

    document.querySelectorAll('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const txt = btn.textContent.trim();
        catLabel.textContent = txt === 'Semua' ? 'Semua Kategori' : txt;
        catPanel.classList.add('hidden');
      });
    });
    document.querySelectorAll('.kelas-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        kelasLabel.textContent = btn.textContent.trim();
        kelasPanel.classList.add('hidden');
      });
    });
